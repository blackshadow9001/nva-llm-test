{
  // Companion chat Worker. Deploy with: npm run deploy
  // The AI key is a secret, never in this file: npx wrangler secret put ANTHROPIC_API_KEY
  "name": "acme-companion",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "MODEL": "claude-opus-5-5",
    "ALLOWED_ORIGINS": "https://rich-bas.github.io,http://localhost:5173,http://localhost:5174"
  }
}
